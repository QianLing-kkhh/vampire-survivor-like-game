{
  "name": "vampire-survivor-like-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --configLoader runner",
    "preview": "vite preview",
    "art001:render-players": "node scripts/art001/run_player_blender_render.mjs",
    "art001:build-pack": "node scripts/art001/run_player_blender_render.mjs && node scripts/art001/build_art001_pack.mjs",
    "art001:self-check": "node scripts/art001/art001_self_check.mjs",
    "art001:package": "node scripts/art001/package_art001.mjs",
    "validate": "node scripts/validate-project.mjs",
    "validate:i18n": "node scripts/check-i18n.mjs",
    "validate:ui": "node scripts/validate-ui.mjs",
    "validate:docs": "node scripts/check-doc-links.mjs",
    "validate:content": "node scripts/check-content-audit.mjs",
    "validate:assets": "node scripts/check-assets.mjs",
    "validate:external-art": "node scripts/validate-external-art.mjs",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "analyze:csv": "node scripts/analyze-playtest-csv.mjs",
    "simulate": "node scripts/run-headless-sim.mjs",
    "simulate:batch": "node scripts/run-headless-batch.mjs",
