{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": ".tmp/headless-sim",
    "declaration": false,
    "sourceMap": false,
    "noEmit": false
  },
  "include": [
    "src/core-sim/**/*.ts",
    "src/sim-analysis/**/*.ts",
    "src/leaderboard/LeaderboardKey.ts",
    "src/leaderboard/LeaderboardKeyFactory.ts",
    "src/run/RunMetadata.ts",
    "src/run/RunModeMetadata.ts",
    "src/run/RunSummary.ts",
    "src/runtime/RunModeConfig.ts",
    "src/runtime/SimulationSpeedConfig.ts",
    "src/strategy/profile/AutoStrategyDefaults.ts",
    "src/strategy/profile/AutoStrategyProfile.ts"
  ]
}
